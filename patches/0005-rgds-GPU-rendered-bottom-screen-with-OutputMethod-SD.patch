   return SDL_HITTEST_NORMAL;
 }
 
+// zelda3-ds: ZELDA3_PERF_LOG=1 prints frame timings to stdout (log.txt) every ~5 s.
+static bool g_perf_log;
+static double g_perf_ppu_ms;  // ZeldaDrawPpuFrame of the last drawn frame
+static struct {
+  uint64 last_loop;
+  double emu, ppu, present, bottom, worst;
+  int frames, drawn, slow;
+  uint32 since;
+} g_perf;
+
+static double PerfMs(uint64 a, uint64 b) {
+  return (double)(b - a) * 1000.0 / (double)SDL_GetPerformanceFrequency();
+}
+
+static void PerfReport(uint64 now) {
+  if (!g_perf.since) g_perf.since = SDL_GetTicks();
+  uint32 el = SDL_GetTicks() - g_perf.since;
+  if (el < 5000 || !g_perf.frames) return;
+  int d = g_perf.drawn ? g_perf.drawn : 1;
+  printf("perf: %.1f fps | emu %.2f ms | ppu %.2f | present %.2f | bottom %.2f | worst frame %.1f ms | >20ms: %d/%d\n",
+         g_perf.frames * 1000.0 / el, g_perf.emu / g_perf.frames, g_perf.ppu / d, g_perf.present / d,
+         g_perf.bottom / d, g_perf.worst, g_perf.slow, g_perf.frames);
+  fflush(stdout);
+  memset(&g_perf, 0, sizeof(g_perf));
+  g_perf.since = SDL_GetTicks();
+  g_perf.last_loop = now;
+}
+
 static void DrawPpuFrameWithPerf() {
   int render_scale = PpuGetCurrentRenderScale(g_zenv.ppu, g_ppu_render_flags);
   uint8 *pixel_buffer = 0;
@@ -171,6 +199,10 @@ static void DrawPpuFrameWithPerf() {
     history[history_pos] = v;
     history_pos = (history_pos + 1) & 63;
     g_curr_fps = average * (1.0f / 64);
+  } else if (g_perf_log) {
+    uint64 before = SDL_GetPerformanceCounter();
+    ZeldaDrawPpuFrame(pixel_buffer, pitch, g_ppu_render_flags);
+    g_perf_ppu_ms = PerfMs(before, SDL_GetPerformanceCounter());
   } else {
     ZeldaDrawPpuFrame(pixel_buffer, pitch, g_ppu_render_flags);
   }
@@ -330,6 +362,9 @@ static bool SdlRenderer_Init(SDL_Window *window) {
   }
   SDL_RendererInfo renderer_info;
   SDL_GetRendererInfo(renderer, &renderer_info);
+  printf("top screen: SDL renderer '%s'%s%s\n", renderer_info.name,
