 #include <SDL.h>
 #include <math.h>
 #include <stdbool.h>
@@ -1128,6 +1128,38 @@ static void draw_tab_bar(float tab_h) {
 // public API
 
 static SDL_Window *main_win;
+
+// zelda3-ds: draw the bottom screen on the GPU when the game itself uses an
+// accelerated SDL renderer (OutputMethod = SDL): both are SDL renderers, so SDL
+// switches their GL contexts itself. With OutputMethod OpenGL / OpenGL ES the
+// game owns a raw GL context and the bottom stays on the software renderer.
+// ZELDA3_SECOND_SCREEN_RENDERER=software|accelerated overrides the choice.
+// No vsync here: the game's present already paces the frame.
+static SDL_Renderer *create_ss_renderer(void) {
+  bool accel = false;
+  SDL_Renderer *mr = main_win ? SDL_GetRenderer(main_win) : NULL;
+  SDL_RendererInfo mi;
+  if (mr && SDL_GetRendererInfo(mr, &mi) == 0 && (mi.flags & SDL_RENDERER_ACCELERATED))
+    accel = true;
+  const char *env = SDL_getenv("ZELDA3_SECOND_SCREEN_RENDERER");
+  if (env && !SDL_strcasecmp(env, "software")) accel = false;
+  else if (env && !SDL_strcasecmp(env, "accelerated")) accel = true;
+
+  SDL_Renderer *r = NULL;
+  if (accel) {
+    r = SDL_CreateRenderer(ss_win, -1, SDL_RENDERER_ACCELERATED);
+    if (!r) fprintf(stderr, "second screen: accelerated renderer failed (%s), using software\n", SDL_GetError());
+  }
+  if (!r) r = SDL_CreateRenderer(ss_win, -1, SDL_RENDERER_SOFTWARE);
+  if (r) {
+    SDL_RendererInfo ri;
+    SDL_GetRendererInfo(r, &ri);
+    printf("second screen: SDL renderer '%s'%s\n", ri.name,
+           (ri.flags & SDL_RENDERER_ACCELERATED) ? " accelerated" : " software");
+    fflush(stdout);
+  }
+  return r;
+}
 static bool ss_enabled;
 
 bool SecondScreenSDL_Init(SDL_Window *main_window) {
@@ -1172,7 +1204,7 @@ static bool ensure_window(void) {
     ss_enabled = false;
     return false;
   }
-  ss_r = SDL_CreateRenderer(ss_win, -1, SDL_RENDERER_SOFTWARE);
+  ss_r = create_ss_renderer();
   if (!ss_r) {
     fprintf(stderr, "second screen: CreateRenderer failed: %s\n", SDL_GetError());
     SDL_DestroyWindow(ss_win); ss_win = NULL;
@@ -1431,7 +1463,7 @@ static void destroy_textures(void) {
 static void rebuild_renderer(int w2, int h2) {
   destroy_textures();
   if (ss_r) SDL_DestroyRenderer(ss_r);
-  ss_r = SDL_CreateRenderer(ss_win, -1, SDL_RENDERER_SOFTWARE);
