+         (renderer_info.flags & SDL_RENDERER_PRESENTVSYNC) ? " vsync" : "");
   if (kDebugFlag) {
     printf("Supported texture formats:");
     for (int i = 0; i < renderer_info.num_texture_formats; i++)
@@ -568,6 +603,10 @@ int main(int argc, char** argv) {
 
   bool running = true;
   SDL_Event event;
+  {
+    const char *pl = SDL_getenv("ZELDA3_PERF_LOG");
+    g_perf_log = pl && pl[0] == '1';
+  }
   uint32 lastTick = SDL_GetTicks();
   uint32 curTick = 0;
   uint32 frameCtr = 0;
@@ -638,10 +677,24 @@ int main(int argc, char** argv) {
     extern void SecondScreen_RunFrameHook(void);
     SecondScreen_RunFrameHook();
 
+    uint64 perf_t0 = g_perf_log ? SDL_GetPerformanceCounter() : 0;
+    if (g_perf_log) {
+      if (g_perf.last_loop) {
+        double loop_ms = PerfMs(g_perf.last_loop, perf_t0);
+        if (loop_ms > g_perf.worst) g_perf.worst = loop_ms;
+        if (loop_ms > 20.0) g_perf.slow++;
+        g_perf.frames++;
+      }
+      g_perf.last_loop = perf_t0;
+    }
+
     SDL_LockMutex(g_audio_mutex);
     bool is_replay = ZeldaRunFrame(inputs);
     SDL_UnlockMutex(g_audio_mutex);
 
+    uint64 perf_t1 = g_perf_log ? SDL_GetPerformanceCounter() : 0;
+    if (g_perf_log) g_perf.emu += PerfMs(perf_t0, perf_t1);
+
     frameCtr++;
 
     if ((g_turbo ^ (is_replay & g_replay_turbo)) && (frameCtr & (g_turbo ? 0xf : 0x7f)) != 0) {
@@ -649,7 +702,16 @@ int main(int argc, char** argv) {
     }
 
     DrawPpuFrameWithPerf();
+    uint64 perf_t2 = g_perf_log ? SDL_GetPerformanceCounter() : 0;
     SecondScreenSDL_Update();
+    if (g_perf_log) {
+      uint64 perf_t3 = SDL_GetPerformanceCounter();
+      g_perf.drawn++;
+      g_perf.ppu += g_perf_ppu_ms;
+      g_perf.present += PerfMs(perf_t1, perf_t2) - g_perf_ppu_ms;
+      g_perf.bottom += PerfMs(perf_t2, perf_t3);
+      PerfReport(perf_t3);
+    }
 
     if (g_config.display_perf_title) {
       char title[60];
