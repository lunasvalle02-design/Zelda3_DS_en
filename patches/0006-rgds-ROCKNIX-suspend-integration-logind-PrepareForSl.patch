+#endif
   uint32 lastTick = SDL_GetTicks();
   uint32 curTick = 0;
   uint32 frameCtr = 0;
@@ -657,6 +664,29 @@ int main(int argc, char** argv) {
       }
     }
 
+#ifdef ZELDA3_ROCKNIX_SLEEP
+    // zelda3-ds: ROCKNIX is about to suspend (power key / lid): stop the sound and,
+    // with Autosave on, write the state that will be loaded on the next start, in
+    // case the battery runs out while asleep. Then let logind go ahead.
+    switch (RocknixSleep_Poll()) {
+    case kRocknixSleep_GoingToSleep:
+      printf("suspend: going to sleep\n");
+      if (device)
+        SDL_PauseAudioDevice(device, 1);
+      if (g_config.autosave)
+        HandleCommand(kKeys_Save + 0, true);
+      fflush(stdout);
+      RocknixSleep_Ready();
+      break;
+    case kRocknixSleep_Resumed:
+      printf("suspend: resumed\n");
+      fflush(stdout);
+      lastTick = SDL_GetTicks();   // don't try to catch up on the time spent asleep
+      if (device && !g_paused)
+        SDL_PauseAudioDevice(device, 0);
+      break;
+    }
+#endif
