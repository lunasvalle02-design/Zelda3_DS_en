 static bool g_run_without_emu = 0;
 
@@ -607,6 +611,9 @@ int main(int argc, char** argv) {
     const char *pl = SDL_getenv("ZELDA3_PERF_LOG");
     g_perf_log = pl && pl[0] == '1';
   }
+#ifdef ZELDA3_ROCKNIX_SLEEP
