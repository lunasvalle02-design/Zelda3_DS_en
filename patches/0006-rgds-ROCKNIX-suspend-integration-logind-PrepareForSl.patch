@@ -28,6 +28,10 @@
 #include "util.h"
 #include "audio.h"
 #include "android_logging.h"
+#if defined(__linux__) && !defined(__ANDROID__)
+#define ZELDA3_ROCKNIX_SLEEP 1
+#include "platform/linux/rocknix_sleep.h"
