+static void settings_tap(float x, float y) {
+  if (in_rect(&save_state_r, x, y)) { SS_SaveLoadState(true);  show_toast("STATE SAVED");  return; }
+  if (in_rect(&load_state_r, x, y)) { SS_SaveLoadState(false); show_toast("STATE LOADED"); return; }
+  int hit = -1;
+  for (int i = 0; i < SET_COUNT; i++)
+    if (i != SET_STATES && in_rect(&settings_row_r[i], x, y)) { hit = i; break; }
+  if (hit != SET_QUIT) quit_armed_until = 0;
+  switch (hit) {
+  case SET_ASPECT: {
+    int next = (SS_GetTopAspect() + 1) % 4;
+    SS_SetTopAspect(next);
+    update_ini("[General]", "TopScreenAspect", kAspectIni[next]);
+    break;
+  }
+  case SET_HUD: {
+    bool hide = !SS_IsHudHidden();
+    SS_SetHudHidden(hide);
+    if (hide) { FILE *f = fopen(".ss_hidehud", "wb"); if (f) fclose(f); }
+    else remove(".ss_hidehud");
+    break;
+  }
+  case SET_CRT: {
+    bool on = !SS_IsCrtFilter();
+    SS_SetCrtFilter(on);
+    update_ini("[Graphics]", "CrtFilter", on ? "1" : "0");
+    break;
+  }
+  case SET_AUTOSAVE: {
+    bool on = !SS_GetAutosave();
+    SS_SetAutosave(on);
+    update_ini("[General]", "Autosave", on ? "1" : "0");
+    break;
+  }
+  case SET_REMAP:
+    SS_GetGamepadControls(pad_controls);
+    remap_mode = true;
+    break;
+  case SET_QUIT:
+    if (quit_armed_until && SDL_GetTicks() < quit_armed_until) {
+      SDL_Event quit = { .type = SDL_QUIT };
+      SDL_PushEvent(&quit);
     } else {
-      draw_text(values[i], row->x + row->w - 22 * u - text_width(values[i], 3 * u), ty, 3 * u);
+      quit_armed_until = SDL_GetTicks() + 3000;
     }
+    break;
   }
 }
 
