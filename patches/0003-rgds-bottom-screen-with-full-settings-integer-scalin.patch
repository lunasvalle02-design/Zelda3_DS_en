+// One in-game map objective (WorldMap_HandleSprites): blinking X for "go here",
+// otherwise the pendant / Master Sword / crystal / tower icon, blinking like the game.
+static void draw_marker(int icon, int index, float mx, float my) {
+  bool blink_on = (SDL_GetTicks() / 267) & 1;   // frame_counter & 0x10 at 60 fps
+  float r = 9 * u;
+  if (icon == 0 || icon == 0x66) {
+    float pulse = 1.0f + 0.25f * sinf(SDL_GetTicks() / 120.0f);
+    if (icon == 0x66) {   // Agahnim's / Ganon's tower: gold ring behind the X
+      stroke_circle(mx, my, 14 * u, 4 * u, COL_OUTLINE);
+      stroke_circle(mx, my, 14 * u, 2.5f * u, COL_GOLD);
+    }
+    draw_x_mark(mx, my, r * pulse, 8 * u, COL_OUTLINE);
+    draw_x_mark(mx, my, r * pulse, 4.5f * u, COL(224, 40, 32));
+    return;
+  }
+  if (!blink_on) return;
+  if (icon == 0x62) {   // Master Sword
+    fill_circle(mx, my, 15 * u, COL_OUTLINE);
+    draw_icon(SS_ICON_SWORD_2, mx - 8 * px_scale(1.6f * u), my - 8 * px_scale(1.6f * u), 1.6f * u);
+    return;
+  }
+  uint32_t c;
+  if (icon == 0x60) {   // pendants: Courage (Eastern), Wisdom (Hera), Power (Desert)
+    static const uint32_t kPendantCol[3] = {COL(64, 200, 88), COL(230, 60, 60), COL(70, 110, 240)};
+    c = kPendantCol[index < 3 ? index : 0];
+    stroke_circle(mx, my - 9 * u, 4 * u, 2 * u, COL_GOLD);
+    fill_circle(mx, my + 2 * u, 10 * u, COL_OUTLINE);
+    fill_circle(mx, my + 2 * u, 7.5f * u, c);
+    fill_circle(mx - 2.5f * u, my - 0.5f * u, 2.5f * u, COL(255, 255, 255));
+    return;
+  }
+  // crystal: diamond
+  c = COL(120, 200, 255);
+  for (float d = 0; d <= 12 * u; d += 1.0f) {
+    float hw = (12 * u - d) * 0.75f;
+    fill_rect(mx - hw - 1.5f * u, my - d, 2 * hw + 3 * u, 1.0f, COL_OUTLINE);
+    fill_rect(mx - hw - 1.5f * u, my + d, 2 * hw + 3 * u, 1.0f, COL_OUTLINE);
+  }
+  for (float d = 0; d <= 10 * u; d += 1.0f) {
+    float hw = (10 * u - d) * 0.75f;
+    fill_rect(mx - hw, my - d, 2 * hw, 1.0f, d < 3 * u ? COL(230, 245, 255) : c);
+    fill_rect(mx - hw, my + d, 2 * hw, 1.0f, c);
+  }
+}
