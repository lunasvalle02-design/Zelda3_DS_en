+// zelda3-ds: top screen aspect mode (kTopAspect_*), applied on the game thread.
+void SS_SetTopAspect(int mode) {
+  if (mode >= 0 && mode < kTopAspect_Count) g_pending_top_aspect = mode;
+}
+
+int SS_GetTopAspect(void) {
+  int pending = g_pending_top_aspect;
+  if (pending >= 0) return pending;
+  extern int ZeldaGetTopAspect(void);
+  return ZeldaGetTopAspect();
+}
+
+bool SS_GetAutosave(void) { return g_config.autosave; }
+
+// zelda3-ds: in-game world map objective markers (see WorldMap_GetObjectiveMarkers).
+int SS_GetMapMarkers(bool dark_world, int *out, int cap) {
+  WorldMapMarker m[7];
+  int n = WorldMap_GetObjectiveMarkers(dark_world, m, cap < 7 ? cap : 7);
+  for (int i = 0; i < n; i++) {
+    out[i * 5 + 0] = m[i].x;
+    out[i * 5 + 1] = m[i].y;
+    out[i * 5 + 2] = m[i].icon;
+    out[i * 5 + 3] = m[i].index;
+    out[i * 5 + 4] = m[i].stage;
+  }
+  return n;
+}
+
 void SS_SetCrtFilter(bool on) { g_pending_crt_filter = on ? 1 : 0; }
 
