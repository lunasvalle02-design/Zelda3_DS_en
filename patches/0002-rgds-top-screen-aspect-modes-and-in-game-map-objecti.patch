@@ -387,16 +388,16 @@ int ZeldaGetSnesHeight(void) {
   return g_snes_height;
 }
 
-// Toggle the extended aspect ratio while running (game thread).
-void ZeldaSetWidescreen(bool enable) {
-  int extra = enable ? (g_snes_height * 16 / 9 - 256) / 2 : 0;
+// Change the extra columns rendered on each side while running (game thread).
+static void ZeldaSetExtraWidth(int extra) {
   g_config.extended_aspect_ratio = extra;
   g_zenv.ppu->extraLeftRight = UintMin(extra, kPpuExtraLeftRight);
-  if (!enable)
+  if (!extra)
     PpuSetExtraSideSpace(g_zenv.ppu, 0, 0, 0);
   g_snes_width = extra * 2 + 256;
-  if (g_renderer && !g_config.ignore_aspect_ratio)
-    SDL_RenderSetLogicalSize(g_renderer, g_snes_width, g_snes_height);
+  if (g_renderer)
+    SDL_RenderSetLogicalSize(g_renderer, g_config.ignore_aspect_ratio ? 0 : g_snes_width,
+                             g_config.ignore_aspect_ratio ? 0 : g_snes_height);
   if (g_texture) {
     SDL_DestroyTexture(g_texture);
     int tex_mult = (g_ppu_render_flags & kPpuRenderFlags_4x4Mode7) ? 4 : 1;
@@ -405,6 +406,32 @@ void ZeldaSetWidescreen(bool enable) {
   }
 }
 
+void ZeldaSetWidescreen(bool enable) {
+  ZeldaSetExtraWidth(enable ? (g_snes_height * 16 / 9 - 256) / 2 : 0);
+}
+
+// zelda3-ds: extra columns per side so square pixels fill a 4:3 screen
+static int TopAspectExtraWidth(int mode, int snes_height) {
+  return mode == kTopAspect_Wide ? (snes_height * 4 / 3 - 256) / 2 : 0;
+}
+
+// zelda3-ds: switch the top screen aspect mode while running (game thread).
+void ZeldaSetTopAspect(int mode) {
+  if (mode < 0 || mode >= kTopAspect_Count) return;
+  g_config.top_aspect = mode;
+  g_config.top_aspect_set = true;
+  g_config.ignore_aspect_ratio = mode == kTopAspect_Stretch;
+  ZeldaSetExtraWidth(TopAspectExtraWidth(mode, g_snes_height));
+  if (g_renderer)
+    SDL_RenderSetIntegerScale(g_renderer, mode == kTopAspect_Pixel);
+}
+
+int ZeldaGetTopAspect(void) {
+  if (g_config.top_aspect_set) return g_config.top_aspect;
+  if (g_config.ignore_aspect_ratio) return kTopAspect_Stretch;
+  return g_config.extended_aspect_ratio ? kTopAspect_Wide : kTopAspect_Original;
+}
+
 static const struct RendererFuncs kSdlRendererFuncs  = {
   &SdlRenderer_Init,
   &SdlRenderer_Destroy,
@@ -430,6 +457,14 @@ int main(int argc, char** argv) {
   LoadLinkGraphics();
 
   ZeldaInitialize();
+  if (g_config.top_aspect_set) {
+    int h = g_config.extend_y ? 240 : 224;
+    g_config.ignore_aspect_ratio = g_config.top_aspect == kTopAspect_Stretch;
+    g_config.extended_aspect_ratio = TopAspectExtraWidth(g_config.top_aspect, h);
+    uint32 wide_bits = kFeatures0_ExtendScreen64 | kFeatures0_WidescreenVisualFixes;
+    g_config.features0 = g_config.extended_aspect_ratio ? (g_config.features0 | wide_bits)
+                                                        : (g_config.features0 & ~wide_bits);
+  }
   g_zenv.ppu->extraLeftRight = UintMin(g_config.extended_aspect_ratio, kPpuExtraLeftRight);
   g_snes_width = (g_config.extended_aspect_ratio * 2 + 256);
   g_snes_height = (g_config.extend_y ? 240 : 224);
diff --git a/app/jni/src/src/messaging.c b/app/jni/src/src/messaging.c
