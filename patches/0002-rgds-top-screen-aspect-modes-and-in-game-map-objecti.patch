   SetOamPlain(&oam_buf[spr], x, y, ch, flags, big);
 }
 
+// zelda3-ds: the objective icons the in-game world map would draw, with the same
+// rules as WorldMap_HandleSprites, for the second screen. Positions are overworld
+// pixel coordinates (0..4095, like link_x_coord). Returns how many were written.
+int WorldMap_GetObjectiveMarkers(bool dark_world, WorldMapMarker *out, int cap) {
+  static const uint16 *const kXs[7] = {kOwMapCrystal0_x, kOwMapCrystal1_x, kOwMapCrystal2_x, kOwMapCrystal3_x,
+                                       kOwMapCrystal4_x, kOwMapCrystal5_x, kOwMapCrystal6_x};
+  static const uint16 *const kYs[7] = {kOwMapCrystal0_y, kOwMapCrystal1_y, kOwMapCrystal2_y, kOwMapCrystal3_y,
+                                       kOwMapCrystal4_y, kOwMapCrystal5_y, kOwMapCrystal6_y};
+  static const uint16 *const kTabs[7] = {kOwMapCrystal0_tab, kOwMapCrystal1_tab, kOwMapCrystal2_tab, kOwMapCrystal3_tab,
+                                         kOwMapCrystal4_tab, kOwMapCrystal5_tab, kOwMapCrystal6_tab};
+  int k = savegame_map_icons_indicator;
+  if (k > 8 || save_ow_event_info[0x5b] & 0x20 || ((k >= 6) != dark_world))
+    return 0;
+  int n = 0;
+  for (int i = 0; i < 7 && n < cap; i++) {
+    if (i < 3 && OverworldMap_CheckForPendant(i))
+      continue;
+    if (OverworldMap_CheckForCrystal(i) || sign16(kXs[i][k]))
+      continue;
+    out[n].x = kXs[i][k];
+    out[n].y = kYs[i][k];
+    out[n].icon = kTabs[i][k] >> 8;   // 0 = blinking X, else the map sprite tile
+    out[n].index = i;
+    out[n].stage = k;
+    n++;
+  }
+  return n;
+}
+
 bool OverworldMap_CheckForPendant(int k) {  // 8ac5a9
   return (savegame_map_icons_indicator == 3) && (link_which_pendants & kPendantBitMask[k]) != 0;
 }
