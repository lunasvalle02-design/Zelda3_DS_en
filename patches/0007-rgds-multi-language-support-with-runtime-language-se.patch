diff --git a/app/jni/src/src/i18n.c b/app/jni/src/src/i18n.c
new file mode 100644
index 0000000..a27abbd
--- /dev/null
+++ b/app/jni/src/src/i18n.c
@@ -0,0 +1,463 @@
+// zelda3-ds: runtime language selection (see i18n.h).
+#include "i18n.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "assets.h"
+#include "zelda_rtl.h"
+
+enum { kMaxLanguages = 32, kMaxCode = 16, kMaxName = 32 };
+
+typedef struct { char *key, *value; } I18nEntry;
+
+static char g_codes[kMaxLanguages][kMaxCode];
+static char g_names[kMaxLanguages][kMaxName];
+static int g_count;
+static int g_current;
+static uint32 g_generation;
+static I18nEntry *g_entries;
+static int g_entry_count, g_entry_cap;
+static char *g_file_data;
+static bool g_debug;
+
+// ---------------------------------------------------------------------------
+// Strings file: lang/<code>.ini
+
+static char *Trim(char *s) {
+  while (*s == ' ' || *s == '\t') s++;
+  char *e = s + strlen(s);
+  while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) *--e = 0;
+  return s;
+}
+
+static char *ReadFile(const char *path) {
+  FILE *f = fopen(path, "rb");
+  if (!f) return NULL;
+  fseek(f, 0, SEEK_END);
+  long size = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  char *buf = NULL;
+  if (size >= 0 && size < (1 << 20) && (buf = malloc(size + 1)) != NULL) {
+    if (fread(buf, 1, size, f) != (size_t)size) {
+      free(buf);
+      buf = NULL;
+    } else {
+      buf[size] = 0;
+    }
+  }
+  fclose(f);
+  return buf;
+}
+
+static void FreeStrings(void) {
+  for (int i = 0; i < g_entry_count; i++)
+    free(g_entries[i].key);
+  free(g_entries);
+  free(g_file_data);
+  g_entries = NULL;
+  g_entry_count = g_entry_cap = 0;
+  g_file_data = NULL;
+}
+
+// Parses an ini file. Calls cb(section, key, value) for every entry.
+static void ParseIni(char *data, void (*cb)(const char *, const char *, const char *, void *), void *ctx) {
+  char section[64] = "";
+  char *line = data;
+  if ((uint8)line[0] == 0xef && (uint8)line[1] == 0xbb && (uint8)line[2] == 0xbf)
+    line += 3;  // UTF-8 BOM
+  while (line && *line) {
+    char *nl = strchr(line, '\n');
+    if (nl) *nl = 0;
+    char *t = Trim(line);
+    if (*t == '[') {
+      char *end = strchr(t, ']');
+      if (end) {
+        *end = 0;
+        snprintf(section, sizeof(section), "%s", Trim(t + 1));
+      }
+    } else if (*t && *t != '#' && *t != ';') {
+      char *eq = strchr(t, '=');
+      if (eq) {
+        *eq = 0;
+        cb(section, Trim(t), Trim(eq + 1), ctx);
+      }
+    }
+    line = nl ? nl + 1 : NULL;
+  }
+}
+
+static void AddEntry(const char *section, const char *key, const char *value, void *ctx) {
+  (void)ctx;
+  if (g_entry_count == g_entry_cap) {
+    g_entry_cap = g_entry_cap ? g_entry_cap * 2 : 128;
+    g_entries = realloc(g_entries, sizeof(I18nEntry) * g_entry_cap);
+  }
+  size_t ls = strlen(section), lk = strlen(key), lv = strlen(value);
+  char *k = malloc(ls + lk + lv + 3);
+  sprintf(k, "%s.%s", section, key);
+  char *v = k + ls + lk + 2;
+  memcpy(v, value, lv + 1);
+  for (char *p = k; *p && p < v; p++)
+    *p = (char)tolower((uint8)*p);  // keys are case-insensitive
+  g_entries[g_entry_count].key = k;
+  g_entries[g_entry_count].value = v;
+  g_entry_count++;
+}
+
+static void LoadStrings(const char *code) {
+  FreeStrings();
+  if (!strcmp(code, "us"))
+    return;
+  char path[64];
+  snprintf(path, sizeof(path), "lang/%s.ini", code);
+  g_file_data = ReadFile(path);
+  if (!g_file_data) {
+    fprintf(stderr, "i18n: %s not found, interface texts stay in English\n", path);
+    return;
+  }
+  char *copy = strdup(g_file_data);
+  ParseIni(copy, AddEntry, NULL);
+  free(copy);
+}
+
+const char *I18n_Get(const char *key, const char *fallback) {
+  char lk[160];
+  size_t n = 0;
+  for (; key[n] && n < sizeof(lk) - 1; n++)
+    lk[n] = (char)tolower((uint8)key[n]);
+  lk[n] = 0;
+  for (int i = 0; i < g_entry_count; i++)
+    if (!strcmp(g_entries[i].key, lk))
+      return g_entries[i].value;
+  return fallback;
+}
+
+typedef struct { char *out; size_t size; } NameCtx;
+static void FindName(const char *section, const char *key, const char *value, void *ctx) {
+  NameCtx *nc = ctx;
+  if (!strcmp(section, "language") && !strcmp(key, "name") && nc->out[0] == 0)
+    snprintf(nc->out, nc->size, "%s", value);
+}
+
+// ---------------------------------------------------------------------------
+// Language list and selection
+
+static void Enumerate(void) {
+  g_count = 0;
+  for (int i = 0; g_count < kMaxLanguages; i++) {
+    MemBlk mb = kDialogueMap(i);
+    if (mb.ptr == 0)
+      break;
+    MemBlk name = FindIndexInMemblk(mb, 0);
+    size_t n = name.size < kMaxCode - 1 ? name.size : kMaxCode - 1;
+    memcpy(g_codes[g_count], name.ptr, n);
+    g_codes[g_count][n] = 0;
+    g_names[g_count][0] = 0;
+    if (!strcmp(g_codes[g_count], "us")) {
+      strcpy(g_names[g_count], "ENGLISH");
+    } else {
+      char path[64];
+      snprintf(path, sizeof(path), "lang/%s.ini", g_codes[g_count]);
+      char *data = ReadFile(path);
+      if (data) {
+        NameCtx nc = { g_names[g_count], kMaxName };
+        ParseIni(data, FindName, &nc);
+        free(data);
+      }
+      if (!g_names[g_count][0])
+        for (size_t j = 0; j <= n; j++)
+          g_names[g_count][j] = (char)toupper((uint8)g_codes[g_count][j]);
+    }
+    g_count++;
+  }
+  if (g_count == 0) {  // very old asset file without a language map
+    strcpy(g_codes[0], "us");
+    strcpy(g_names[0], "ENGLISH");
+    g_count = 1;
+  }
+}
+
+static int FindLanguage(const char *code) {
+  for (int i = 0; i < g_count; i++)
+    if (!strcmp(g_codes[i], code))
+      return i;
+  return -1;
+}
+
+bool I18n_SetLanguage(const char *code) {
+  if (!code || !*code)
+    code = "us";
+  int i = FindLanguage(code);
+  if (i < 0) {
+    fprintf(stderr, "i18n: language '%s' is not in zelda3_assets.dat\n", code);
+    return false;
+  }
+  ZeldaSetLanguage(g_codes[i]);
+  LoadStrings(g_codes[i]);
+  g_current = i;
+  g_generation++;
+  printf("i18n: language %s (%s)\n", g_codes[i], g_names[i]);
+  return true;
+}
+
+void I18n_Init(const char *code) {
+  g_debug = getenv("ZELDA3_I18N_DEBUG") != NULL;
+  Enumerate();
+  if (!I18n_SetLanguage(code))
+    I18n_SetLanguage("us");
+}
+
+const char *I18n_CurrentCode(void) { return g_codes[g_current]; }
+int I18n_CurrentIndex(void) { return g_current; }
+int I18n_LanguageCount(void) { return g_count; }
+const char *I18n_LanguageCode(int i) { return (i >= 0 && i < g_count) ? g_codes[i] : "us"; }
+const char *I18n_LanguageName(int i) { return (i >= 0 && i < g_count) ? g_names[i] : "ENGLISH"; }
+uint32 I18n_Generation(void) { return g_generation; }
+
+// ---------------------------------------------------------------------------
+// Text helpers
+
+// Decodes one UTF-8 character and returns its plain upper/lower case ASCII
+// letter (accents dropped), or the character itself for ASCII.
+static int NextChar(const char **ps) {
+  const uint8 *s = (const uint8 *)*ps;
+  uint32 c = *s++;
+  if (c >= 0xc0 && (*s & 0xc0) == 0x80) {
+    if (c < 0xe0) {
+      c = (c & 0x1f) << 6 | (*s++ & 0x3f);
+    } else {
+      // three or more bytes: skip, not a Latin letter
+      while ((*s & 0xc0) == 0x80) s++;
+      c = '?';
+    }
+  }
+  *ps = (const char *)s;
+  if (c < 0x80)
+    return (int)c;
+  static const char kLatin1[] =  // U+00C0 .. U+00FF without accents
+      "AAAAAAACEEEEIIIIDNOOOOOxOUUUUYTs"
+      "aaaaaaaceeeeiiiidnooooo/ouuuuyty";
+  if (c >= 0xc0 && c <= 0xff)
+    return kLatin1[c - 0xc0];
+  if (c == 0xa1) return '!';  // inverted marks: not in the fonts
+  if (c == 0xbf) return '?';
+  return '?';
+}
+
+// Converts a UTF-8 string to plain ASCII (accents dropped, inverted ! and ?
+// removed).
+static void ToAscii(const char *s, char *out, size_t size, bool upper) {
+  size_t n = 0;
+  while (*s && n + 1 < size) {
+    bool inverted = (uint8)s[0] == 0xc2 && ((uint8)s[1] == 0xa1 || (uint8)s[1] == 0xbf);
+    int c = NextChar(&s);
+    if (inverted)
+      continue;
+    out[n++] = (char)(upper ? toupper(c) : c);
+  }
+  out[n] = 0;
+}
+
+// ---------------------------------------------------------------------------
+// Pause menu (HUD letter tiles: A-Z at 0x150, blank 0xf5, small dot 0x16a)
+
+static uint16 HudTile(int c) {
+  if (c >= 'A' && c <= 'Z') return 0x150 + (c - 'A');
+  if (c == '-' || c == '.') return 0x16a;
+  return 0xf5;
+}
+
+static void HudRow(const char *s, uint16 *out, int width, uint16 attr, bool right) {
+  int len = (int)strlen(s);
+  if (len > width) len = width;
+  int start = right ? width - len : 0;
+  for (int i = 0; i < width; i++)
+    out[i] = attr | 0xf5;
+  for (int i = 0; i < len; i++)
+    out[start + i] = attr | HudTile((uint8)s[i]);
+}
+
+bool I18n_HudText(const char *key, uint16 *out, int rows, uint16 attr) {
+  char k[64];
+  snprintf(k, sizeof(k), "hud.%s", key);
+  const char *v = I18n_Get(k, NULL);
+  if (!v)
+    return false;
+  char buf[64];
+  ToAscii(v, buf, sizeof(buf), true);
+  char *bar = strchr(buf, '|');
+  if (rows == 1) {
+    if (bar) *bar = ' ';
+    HudRow(Trim(buf), out, 8, attr, false);
+  } else if (bar) {
+    *bar = 0;
+    HudRow(Trim(buf), out, 8, attr, false);
+    HudRow(Trim(bar + 1), out + 8, 8, attr, false);
+  } else {
+    HudRow("", out, 8, attr, false);
+    HudRow(Trim(buf), out + 8, 8, attr, false);
+  }
+  return true;
+}
+
+bool I18n_HudAbility(const char *key, uint16 *out10, uint16 attr, uint16 suffix_tile, int offset) {
+  char k[64];
+  snprintf(k, sizeof(k), "hud.%s", key);
+  const char *v = I18n_Get(k, NULL);
+  if (!v)
+    return false;
+  char buf[32];
+  ToAscii(v, buf, sizeof(buf), true);
+  char *word = Trim(buf);
+  int len = (int)strlen(word), room = 5 - offset - (suffix_tile != 0);
+  if (len > room) len = room;
+  HudRow("", out10, 5, attr, false);
+  HudRow("", out10 + 5, 5, attr, false);
+  for (int i = 0; i < len; i++)
+    out10[5 + offset + i] = attr | HudTile((uint8)word[i]);
+  if (suffix_tile)
+    out10[5 + offset + len] = suffix_tile;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// File select screen. Text there is drawn with the 8x16 dialogue font that
+// TransferFontToVRAM uploads (always the US one): character c uses tile
+// (c & 0x70) * 2 + (c & 0xf) for its top half and that + 16 for the bottom.
+
+static const char kUsFontChars[] =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!?-.,";
+
+static int FontTile(int c) { return (c & 0x70) * 2 + (c & 0xf); }
+
+static int CharToFont(int ch) {
+  if (ch == ' ') return 89;
+  if (ch == 'I') return 95;   // centred I used by the original screens
+  if (ch == '>') return 68;
+  if (ch == '(') return 69;
+  if (ch == ')') return 70;
+  if (ch == '"') return 76;
+  if (ch == '\'') return 81;
+  if (ch == '<') return 90;
+  const char *p = strchr(kUsFontChars, ch);
+  return (p && ch) ? (int)(p - kUsFontChars) : 89;
+}
+
+// Returns the character whose top half is `tile`, or 0.
+static int FontTopChar(int tile) {
+  static char table[0x400];
+  static bool init;
+  if (!init) {
+    static const char kExtra[] = {' ', '>', '(', ')', '"', '\'', '<', 'I'};
+    for (const char *p = kUsFontChars; *p; p++)
+      table[FontTile(CharToFont(*p))] = *p;
+    for (size_t i = 0; i < sizeof(kExtra); i++)
+      table[FontTile(CharToFont(kExtra[i]))] = kExtra[i];
+    table[FontTile(8)] = 'I';  // the regular I too
+    init = true;
+  }
+  return table[tile & 0x3ff];
+}
+
+typedef struct { uint16 dst; int n; char text[64]; } PendingRow;
+
+// stripe words are little endian and not necessarily aligned
+static uint16 GetW(const uint8 *p, int i) { return p[i * 2] | p[i * 2 + 1] << 8; }
+static void SetTile(uint8 *p, int i, int tile) {
+  uint16 v = (GetW(p, i) & 0xfc00) | tile;
+  p[i * 2] = (uint8)v;
+  p[i * 2 + 1] = (uint8)(v >> 8);
+}
+
+void I18n_TranslateStripes(uint8 *p, size_t size) {
+  if (!strcmp(g_codes[g_current], "us") && !g_debug)
+    return;
+  uint8 *end = p + size;
+  PendingRow pend[8];
+  int npend = 0;
+  while (p + 4 <= end && !(p[0] & 0x80)) {
+    uint16 dst = p[0] << 8 | p[1];
+    uint8 flags = p[2];
+    int len = ((flags << 8 | p[3]) & 0x3fff) + 1;
+    p += 4;
+    if (flags & 0x40) { p += 2; continue; }        // fill
+    if (p + len > end) break;
+    int n = len / 2;
+    if ((flags & 0x80) || n > 63) { p += len; continue; }  // vertical
+    // bottom half of a row translated just before?
+    int pi;
+    for (pi = 0; pi < npend; pi++)
+      if ((uint16)(pend[pi].dst + 0x20) == dst && pend[pi].n == n)
+        break;
+    if (pi < npend) {
+      for (int i = 0; i < n; i++)
+        SetTile(p, i, FontTile(CharToFont((uint8)pend[pi].text[i])) + 16);
+      pend[pi] = pend[--npend];
+      p += len;
+      continue;
+    }
+    // decode the row
+    char text[64], key[80];
+    int i, letters = 0;
+    for (i = 0; i < n; i++) {
+      int c = FontTopChar(GetW(p, i));
+      if (!c) break;
+      text[i] = (char)c;
+      letters += isalpha(c) != 0;
+    }
+    if (i == n && letters >= 2) {
+      text[n] = 0;
+      // key: words separated by single spaces
+      size_t k = 0;
+      int lead = 0;
+      while (text[lead] == ' ') lead++;
+      for (const char *s = text + lead; *s && k < sizeof(key) - 1; s++)
+        if (*s != ' ' || (s[1] && s[1] != ' ' && k))
+          key[k++] = *s;
+      key[k] = 0;
+      char lk[96];
+      snprintf(lk, sizeof(lk), "fileselect.%s", key);
+      const char *v = I18n_Get(lk, NULL);
+      if (g_debug)
+        printf("i18n: file select text \"%s\"%s\n", key, v ? " (translated)" : "");
+      if (v && npend < 8) {
+        char val[64];
+        ToAscii(v, val, sizeof(val), false);
+        PendingRow *pr = &pend[npend++];
+        pr->dst = dst;
+        pr->n = n;
+        memset(pr->text, ' ', n);
+        pr->text[n] = 0;
+        size_t vl = strlen(val);
+        if ((int)vl > n - lead) {
+          lead = n - (int)vl;
+          if (lead < 0) { lead = 0; vl = n; }
+        }
+        memcpy(pr->text + lead, val, vl);
+        for (int j = 0; j < n; j++)
+          SetTile(p, j, FontTile(CharToFont((uint8)pr->text[j])));
+      }
+    }
+    p += len;
+  }
+}
+
+const uint8 *I18n_TranslatedTilemap(int which, const uint8 *src, size_t size) {
+  static uint8 *cache[8];
+  static uint32 cache_gen[8];
+  if (which < 0 || which >= 8 || !strcmp(g_codes[g_current], "us"))
+    return src;
+  if (!cache[which] || cache_gen[which] != g_generation) {
+    free(cache[which]);
+    cache[which] = malloc(size);
+    if (!cache[which])
+      return src;
+    memcpy(cache[which], src, size);
+    I18n_TranslateStripes(cache[which], size);
+    cache_gen[which] = g_generation;
+  }
+  return cache[which];
+}
diff --git a/app/jni/src/src/i18n.h b/app/jni/src/src/i18n.h
new file mode 100644
index 0000000..7007dda
--- /dev/null
+++ b/app/jni/src/src/i18n.h
@@ -0,0 +1,46 @@
+// zelda3-ds: runtime language selection.
+//
+// The dialogue of every language lives in zelda3_assets.dat (kDialogueMap,
+// built from lang/<code>/ by tools/lang/build_assets.py). Everything else
+// (pause menu item names, file select screen, bottom-screen UI) comes from
+// lang/<code>.ini next to the executable. "us" is the original English game
+// and needs no file.
+#ifndef ZELDA3_I18N_H_
+#define ZELDA3_I18N_H_
+
+#include "types.h"
+
+// Called once after the assets are loaded. NULL/"" selects English.
+void I18n_Init(const char *code);
+// Switches language at runtime (dialogue, HUD and UI strings). Safe between
+// frames; a message box already on screen keeps its language.
+bool I18n_SetLanguage(const char *code);
+const char *I18n_CurrentCode(void);
+int I18n_CurrentIndex(void);
+// Languages compiled into zelda3_assets.dat, in asset order ("us" first).
+int I18n_LanguageCount(void);
+const char *I18n_LanguageCode(int i);
+// Display name in upper case (from lang/<code>.ini, "ENGLISH" for us).
+const char *I18n_LanguageName(int i);
+// Increments every time the language changes.
+uint32 I18n_Generation(void);
+
+// "section.key" lookup in the current language file; returns `fallback`
+// (the English text) when the key is missing.
+const char *I18n_Get(const char *key, const char *fallback);
+
+// Pause-menu text built from HUD letter tiles (A-Z, accents dropped). Fills
+// `out` with `rows` x 8 tile entries using `attr` for the palette bits and
+// returns true when the current language has `key` in [hud].
+bool I18n_HudText(const char *key, uint16 *out, int rows, uint16 attr);
+// Same for the 5x2-tile ability words of the "DO" box: the word goes on the
+// bottom row starting at tile `offset`, followed by `suffix_tile` (if not 0).
+bool I18n_HudAbility(const char *key, uint16 *out10, uint16 attr, uint16 suffix_tile, int offset);
+
+// File select screen: translates the text rows of a VRAM stripe list
+// (kBgTilemap_* or the vram_upload_data tables of select_file.c) in place.
+void I18n_TranslateStripes(uint8 *stripes, size_t size);
+// Returns a translated copy of a ROM tilemap stripe list (cached).
+const uint8 *I18n_TranslatedTilemap(int which, const uint8 *src, size_t size);
+
+#endif  // ZELDA3_I18N_H_
