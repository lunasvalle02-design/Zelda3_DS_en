# Pinned upstream sources (cloned into external/ by scripts/fetch-sources.sh).
# To update: change the commit, run `make fetch` and check that patches/ still applies.

# Game core + SDL second screen (Linux) — dual-screen branch of the Android port.
ZELDA3_DS_REPO=https://github.com/samyost1/zelda3-android.git
ZELDA3_DS_BRANCH=dual-screen
ZELDA3_DS_COMMIT=4c9aeb8d5568af134230662bd9c05912e151967a
# Subfolder containing the C code (Linux Makefile included)
ZELDA3_DS_SUBDIR=app/jni/src

# Original reimplementation: provides assets/restool.py to generate zelda3_assets.dat
# (same kAssets_Sig signature as the fork above, verified).
ZELDA3_UPSTREAM_REPO=https://github.com/snesrev/zelda3.git
ZELDA3_UPSTREAM_COMMIT=45a149d8b4bb8098f53d1009f76e76e7d8b79bbf

# Target: Anbernic RG DS Plus — Rockchip RK3568 (4x Cortex-A55, Mali-G52 2EE),
# 2 panels at 1024x768. In ROCKNIX it belongs to the RK3566 build device.
TARGET_TRIPLE=aarch64-linux-gnu
TARGET_CFLAGS="-O2 -march=armv8.2-a -mtune=cortex-a55"
